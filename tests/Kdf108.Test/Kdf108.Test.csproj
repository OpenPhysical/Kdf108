<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>false</ImplicitUsings>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Library</OutputType>
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)..\fast.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0"/>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1"/>
    <PackageReference Include="NUnit" Version="5.0.0"/>
    <PackageReference Include="NUnit.Analyzers" Version="4.15.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0"/>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.10.0"/>
    <PackageReference Include="Spectre.Console.Testing" Version="0.57.2"/>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12"/>
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kdf108\Kdf108.csproj"/>
    <ProjectReference Include="..\..\examples\Kdf108.Examples\Kdf108.Examples.csproj"/>
  </ItemGroup>

</Project>
